# Use your computer's LAN address when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Officer dashboard address, linked from the website home page.
EXPO_PUBLIC_DASHBOARD_URL=http://localhost:5173
# Maps JavaScript API key for the web build. Restrict it to your HTTP referrers.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Set to true once the Android key below is configured.
EXPO_PUBLIC_ANDROID_MAPS_ENABLED=false
# Maps SDK for Android key. Restrict it to com.awaaz.citizen and your signing SHA-1.
GOOGLE_MAPS_ANDROID_KEY=
