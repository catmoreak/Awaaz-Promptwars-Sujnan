{
  "name": "@awaaz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "eval:dedupe": "tsx scripts/eval-dedupe.ts",
    "images:move": "tsx scripts/move-images.ts"
  },
  "dependencies": {
    "@awaaz/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1160.0",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "h3-js": "4.5.0",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
