NODE_ENV=development
PORT=4000
# Pooled connection for the running API.
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require'
# Direct (non-pooler) connection for Prisma migrations.
DIRECT_URL='postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require'
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Enables POST /v1/auth/demo. The API refuses to boot with this on in production.
ALLOW_DEMO_LOGIN=false
# Comma-separated Google accounts allowed into the admin dashboard.
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Comma-separated OAuth client IDs accepted as the ID token audience.
GOOGLE_OAUTH_CLIENT_IDS=
# Used for Geocoding and Places. Keep it server-side only.
GOOGLE_MAPS_SERVER_KEY=
# Primary AI provider: analysis, embeddings and voice transcription.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=
MISTRAL_EMBEDDING_MODEL=
MISTRAL_TRANSCRIBE_MODEL=
# Fallback for analysis and briefs if Mistral fails.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
