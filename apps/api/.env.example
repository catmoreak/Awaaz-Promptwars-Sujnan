NODE_ENV=development
PORT=4000
# Pooled connection for the running API.
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full'
# Direct (non-pooler) connection for Prisma migrations.
DIRECT_URL='postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require'
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# The officer account. It is created or updated when the API starts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Only needed if the website is hosted at a different address from the API.
CORS_ORIGINS=
# Used for Geocoding and Places. Keep it server-side only.
GOOGLE_MAPS_SERVER_KEY=
# Cloud Speech-to-Text key for voice input.
GOOGLE_SPEECH_API_KEY=
# Primary AI provider: analysis, embeddings and duplicate review.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=
MISTRAL_EMBEDDING_MODEL=
# Fallback for analysis and briefs if Mistral fails.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
# S3-compatible storage for report photos. Without these, photos stay in Postgres.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
